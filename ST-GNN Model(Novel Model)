def build_clinical_stgnn(input_shape=(500, 12), clinical_shape=(36,)):
# Branch 1: Raw Waveform
waveform_input = Input(shape=input_shape, name='waveform')
x = SeparableConv1D(64, kernel_size=5, padding='same')(waveform_input)
x = BatchNormalization()(x)
x = Activation('relu')(x)
x = GlobalAveragePooling1D()(x)
# Branch 2: Clinical Features
clinical_input = Input(shape=clinical_shape, name='clinical_features')
# Merge branches
# We assign this to 'x' so the next layer can find it
x = Concatenate()([x, clinical_input])
# Deeper Classifier Head
x = Dense(128, activation='relu')(x)
x = BatchNormalization()(x)
x = Dropout(0.4)(x)
x = Dense(64, activation='relu')(x)
outputs = Dense(4, activation='softmax')(x)
return Model(inputs=[waveform_input, clinical_input], outputs=outputs)
