def extract_clinical_features(X):
# 1. QRS: Range between 10th and 90th percentile
qrs_width = np.percentile(X, 90, axis=1) - np.percentile(X, 10, axis=1)
# 2. Heart Rate Proxy: Variance
hr_proxy = np.var(X, axis=1)
# 3. ST-Deviation: Mean of absolute values in the tail
st_deviation = np.mean(np.abs(X[:, 350:, :]), axis=1)
features = np.hstack([qrs_width, hr_proxy, st_deviation])
# MANDATORY: Normalize to 0 mean and 1 variance
return (features - np.mean(features, axis=0)) / (np.std(features, axis=0) + 1e-6)
