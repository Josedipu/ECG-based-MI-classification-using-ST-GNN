import numpy as np
import random
from sklearn.preprocessing import LabelEncoder
from tensorflow.keras.utils import to_categorical
from sklearn.model_selection import train_test_split
from sklearn.utils import class_weight
print("--- 1. PREPARING DATA ---")
# A. Consolidate (Safety Check)
if 'X_combined' not in locals():
if 'all_segments' in locals() and len(all_segments) > 0:
X_combined = np.concatenate(all_segments, axis=0)
else:
raise ValueError("STOP! Data missing. Run Cell 2 (Loading) first.")
# B. Clean NaNs (Critical)
if np.isnan(X_combined).any():
print("⚠️ Cleaning NaNs...")
X_combined = np.nan_to_num(X_combined)
# C. BALANCE DATA (Downsample EMI)
all_labels = ['HC' if x == '0' else x for x in all_labels]
indices_emi = [i for i, label in enumerate(all_labels) if label == 'EMI']
indices_others = [i for i, label in enumerate(all_labels) if label != 'EMI']
if len(indices_emi) > 2000:
print(f"Downsampling {len(indices_emi)} EMI samples to 1,500...")
random.seed(42)
selected_emi_indices = random.sample(indices_emi, 1500)
balanced_indices = indices_others + selected_emi_indices
random.shuffle(balanced_indices)
X_balanced = X_combined[balanced_indices]
Y_balanced = [all_labels[i] for i in balanced_indices]
else:
X_balanced = X_combined
Y_balanced = all_labels
print(f"Balanced Data Size: {len(Y_balanced)}")
# D. FIX UNITS (Per-Sample Normalization - The Key to Success)
print("--- FIXING UNITS ---")
epsilon = 1e-8
# Normalize each heartbeat individually so Units don't matter
mean_val = np.mean(X_balanced, axis=1, keepdims=True)
std_val = np.std(X_balanced, axis=1, keepdims=True)
X_normalized = (X_balanced - mean_val) / (std_val + epsilon)
# E. ENCODE & SPLIT
le = LabelEncoder()
Y_integers = le.fit_transform(Y_balanced)
Y_onehot = to_categorical(Y_integers)
TARGET_CLASSES = list(le.classes_)
print(f"Classes: {TARGET_CLASSES}")
X_train, X_test, Y_train, Y_test = train_test_split(X_normalized, Y_onehot, test_size=0.2, random_state=42, stratify=Y_onehot)
X_train, X_val, Y_train, Y_val = train_test_split(X_train, Y_train, test_size=0.2, random_state=42, stratify=Y_train)
# Weights
Y_train_int = np.argmax(Y_train, axis=1)
class_labels_int = np.unique(Y_train_int)
weights = class_weight.compute_class_weight(class_weight='balanced', classes=class_labels_int, y=Y_train_int)
class_weights_dict = dict(zip(class_labels_int, weights))
print("✅ READY! Run Cell 5 now.")
