import tensorflow as tf
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Conv1D, Bidirectional, LSTM, Dense, Dropout, concatenate, BatchNormalization, Add, Layer
from tensorflow.keras import backend as K
from sklearn.metrics import classification_report
import matplotlib.pyplot as plt
import numpy as np
# Attention Layer Definition
class AttentionLayer(Layer):
def __init__(self, **kwargs):
super(AttentionLayer, self).__init__(**kwargs)
def build(self, input_shape):
self.W = self.add_weight(name='att_weight', shape=(input_shape[-1], 1),
initializer='random_normal', trainable=True)
self.b = self.add_weight(name='att_bias', shape=(input_shape[1], 1),
initializer='zeros', trainable=True)
super(AttentionLayer, self).build(input_shape)
def call(self, inputs):
e = K.tanh(K.dot(inputs, self.W) + self.b) # Shape: (batch, time_steps, 1)
e = K.squeeze(e, axis=-1) # Shape: (batch, time_steps)
alpha = K.softmax(e) # Shape: (batch, time_steps)
alpha_expanded = K.expand_dims(alpha, axis=-1) # (batch, time_steps, 1)
weighted_sum = K.sum(inputs * alpha_expanded, axis=1) # (batch, features)
return weighted_sum
def compute_output_shape(self, input_shape):
return (input_shape[0], input_shape[2])
# Model Building Function with Attention
def build_msar_net_attention(input_shape, num_classes):
input_tensor = Input(shape=input_shape)
# CNN Block (multi-scale kernels)
conv1 = Conv1D(32, 5, activation='relu', padding='same')(input_tensor)
bn1 = BatchNormalization()(conv1)
conv2 = Conv1D(32, 25, activation='relu', padding='same')(input_tensor)
bn2 = BatchNormalization()(conv2)
merged = concatenate([bn1, bn2], axis=-1)
# Residual block
res = Conv1D(64, 1, activation='relu', padding='same')(input_tensor)
conv_out = Add()([merged, res])
conv_out = Dropout(0.3)(conv_out)
# BiLSTM Layers with return_sequences for attention input
lstm1 = Bidirectional(LSTM(64, return_sequences=True))(conv_out)
lstm2 = Bidirectional(LSTM(32, return_sequences=True))(lstm1)
lstm2 = Dropout(0.3)(lstm2)
# Attention layer
attention_output = AttentionLayer()(lstm2)
# Dense and output
dense_intermediate = Dense(64, activation='relu')(attention_output)
output = Dense(num_classes, activation='softmax')(dense_intermediate)
return Model(inputs=input_tensor, outputs=output)
# Instantiate model
INPUT_SHAPE = (X_train.shape[1], X_train.shape[2])
model_attention = build_msar_net_attention(INPUT_SHAPE, len(TARGET_CLASSES))
# Compile model
model_attention.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
# Callbacks setup (same as before)
callbacks = [
tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, verbose=1, min_lr=0.00001),
tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True, verbose=1),
tf.keras.callbacks.ModelCheckpoint('best_ecg_model_attention.keras', monitor='val_loss', save_best_only=True, verbose=1)
]
# Train model
print(f"\n--- Training on {len(X_train)} samples ---")
history = model_attention.fit(
X_train, Y_train,
epochs=50,
batch_size=32,
validation_data=(X_val, Y_val),
class_weight=class_weights_dict,
callbacks=callbacks,
verbose=1
)
