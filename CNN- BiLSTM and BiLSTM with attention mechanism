def bandpass_filter(data, lowcut, highcut, fs, order=4):
nyq = 0.5 * fs
low = lowcut / nyq
high = highcut / nyq
b, a = butter(order, [low, high], btype='band')
y = filtfilt(b, a, data)
return y
def wavelet_denoise(data, wavelet='sym4', level=1):
if np.all(data == 0) or np.std(data) == 0: return data
coeff = pywt.wavedec(data, wavelet, mode='per')
sigma = np.median(np.abs(coeff[-level])) / 0.6745
if sigma == 0: return data
uthresh = sigma * np.sqrt(2 * np.log(len(data)))
coeff[1:] = [pywt.threshold(i, value=uthresh, mode='soft') for i in coeff[1:]]
return pywt.waverec(coeff, wavelet, mode='per')
def lms_filter(desired, input_signal, mu=0.01, filter_order=5):
n_samples = len(input_signal)
w = np.zeros(filter_order)
y = np.zeros(n_samples)
e = np.zeros(n_samples)
epsilon = 1e-6
for n in range(filter_order, n_samples):
x = input_signal[n-filter_order:n][::-1]
y[n] = np.dot(w, x)
e[n] = desired[n] - y[n]
norm_factor = np.dot(x, x) + epsilon
w += (mu / norm_factor) * e[n] * x
return e
def segment_and_downsample(ecg_signal, original_fs=1000, target_fs=125, window_sec=4):
num_samples = int(len(ecg_signal) * target_fs / original_fs)
downsampled = resample(ecg_signal, num_samples)
window_size = window_sec * target_fs
num_windows = num_samples // window_size
segments = []
for i in range(num_windows):
start = i * window_size
end = start + window_size
segments.append(downsampled[start:end])
return np.array(segments)
def preprocess_multilead(record_path, original_fs=1000, target_fs=125, window_sec=4, target_leads=12):
try:
record = wfdb.rdrecord(record_path)
except:
record = wfdb.rdrecord(record_path, channels=[0])
available_leads = record.p_signal.shape[1]
leads_to_process = min(available_leads, target_leads)
all_lead_segments = []
for lead in range(leads_to_process):
ecg_signal = record.p_signal[:, lead]
filtered_signal = bandpass_filter(ecg_signal, 0.5, 40, original_fs)
denoised_signal = wavelet_denoise(filtered_signal)
adapted_signal = lms_filter(denoised_signal, np.roll(denoised_signal, 1))
segments = segment_and_downsample(adapted_signal, original_fs=original_fs, target_fs=target_fs, window_sec=window_sec)
all_lead_segments.append(segments)
if len(all_lead_segments) < target_leads:
if len(all_lead_segments) > 0:
num_segments = all_lead_segments[0].shape[0]
window_size = all_lead_segments[0].shape[1]
for _ in range(target_leads - len(all_lead_segments)):
all_lead_segments.append(np.zeros((num_segments, window_size)))
else:
return np.array([])
all_lead_segments = np.stack(all_lead_segments, axis=0)
all_lead_segments = np.transpose(all_lead_segments, (1, 2, 0))
return all_lead_segments
