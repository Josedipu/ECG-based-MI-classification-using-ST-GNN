import numpy as np # Needed for argmax
import tensorflow as tf
import matplotlib.pyplot as plt
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Conv1D, LSTM, Dense, Dropout, concatenate, BatchNormalization
from sklearn.metrics import classification_report, confusion_matrix
# 1. DEFINE MODEL (Simplified CNN-LSTM)
def build_cnn_lstm_net(input_shape, num_classes):
input_tensor = Input(shape=input_shape)
# CNN Feature Extraction Block (Multi-scale)
conv1 = Conv1D(32, 5, activation='relu', padding='same')(input_tensor)
bn1 = BatchNormalization()(conv1)
conv2 = Conv1D(32, 25, activation='relu', padding='same')(input_tensor)
bn2 = BatchNormalization()(conv2)
merged_cnn_out = concatenate([bn1, bn2], axis=-1)
merged_cnn_out = Dropout(0.3)(merged_cnn_out) # Combined CNN output
# LSTM Block (Single-Directional)
lstm1 = LSTM(64, return_sequences=True)(merged_cnn_out)
lstm2 = LSTM(32)(lstm1) # Final feature vector from sequence
lstm2 = Dropout(0.3)(lstm2)
# Output
out = Dense(num_classes, activation='softmax')(Dense(64, activation='relu')(lstm2))
return Model(inputs=input_tensor, outputs=out)
# 2. COMPILE
INPUT_SHAPE = (X_train.shape[1], X_train.shape[2])
model = build_cnn_lstm_net(INPUT_SHAPE, len(TARGET_CLASSES))
model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
print("\n--- Model Summary (CNN + Standard LSTM) ---")
model.summary()
# 3. CALLBACKS
callbacks = [
tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, verbose=1, min_lr=0.00001),
tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True, verbose=1),
tf.keras.callbacks.ModelCheckpoint('best_ecg_model_simple.keras', monitor='val_loss', save_best_only=True, verbose=1)
]
# 4. TRAIN
print(f"\n--- Training on {len(X_train)} samples ---")
history = model.fit(
X_train, Y_train,
epochs=50,
batch_size=32,
validation_data=(X_val, Y_val),
class_weight=class_weights_dict,
callbacks=callbacks,
verbose=1
)
# 5. EVALUATE
print("\n--- Final Results ---")
loss, acc = model.evaluate(X_test, Y_test, verbose=0)
print(f"Test Accuracy: {acc:.4f}")
Y_pred = np.argmax(model.predict(X_test), axis=1)
Y_true = np.argmax(Y_test, axis=1)
print("\nClassification Report:")
print(classification_report(Y_true, Y_pred, target_names=TARGET_CLASSES))
# 6. PLOT GRAPHS
plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history['loss'], label='Train Loss')
plt.plot(history.history['val_loss'], label='Val Loss')
plt.title('Loss')
plt.legend()
plt.subplot(1, 2, 2)
plt.plot(history.history['accuracy'], label='Train Acc')
plt.plot(history.history['val_accuracy'], label='Val Acc')
plt.title('Accuracy')
plt.legend()
plt.show()
