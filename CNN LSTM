else:
raise ValueError("STOP! Data missing. Rerun Cell 2 (Loading) first.")
# B. Clean NaNs (Critical)
if np.isnan(X_combined).any():
print("⚠️ Cleaning NaNs...")
X_combined = np.nan_to_num(X_combined)
# C. Balance (Re-run for safety)
indices_emi = [i for i, label in enumerate(all_labels) if label == 'EMI']
indices_others = [i for i, label in enumerate(all_labels) if label != 'EMI']
if len(indices_emi) > 2000:
random.seed(42)
selected_emi_indices = random.sample(indices_emi, 1500)
balanced_indices = indices_others + selected_emi_indices
random.shuffle(balanced_indices)
X_balanced = X_combined[balanced_indices]
Y_balanced = [all_labels[i] for i in balanced_indices]
else:
X_balanced = X_combined
Y_balanced = all_labels
# D. FIX UNITS (Per-Sample Normalization - The Key to Success)
print("--- FIXING UNITS (Normalizing) ---")
epsilon = 1e-8
# Normalize each segment/heartbeat individually
mean_val = np.mean(X_balanced, axis=(1, 2), keepdims=True)
std_val = np.std(X_balanced, axis=(1, 2), keepdims=True)
X_normalized = (X_balanced - mean_val) / (std_val + epsilon)
# E. ENCODE & SPLIT
le = LabelEncoder()
Y_integers = le.fit_transform(Y_balanced)
Y_onehot = to_categorical(Y_integers)
TARGET_CLASSES = list(le.classes_)
print(f"Classes: {TARGET_CLASSES}")
# Split 80% Train/Val, 20% Test
X_train_val, X_test, Y_train_val, Y_test = train_test_split(X_normalized, Y_onehot, test_size=0.2, random_state=42, stratify=Y_onehot)
# Split 80% Train, 20% Val
